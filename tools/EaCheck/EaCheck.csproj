<Project Sdk="Microsoft.NET.Sdk">
  <!-- ea-check: lists every game member EmbervilleMP.dll depends on and checks them against another game build.
       Run it through scripts\ea-check.ps1. Build output (bin/obj) stays out of git. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EaCheck</AssemblyName>
    <RootNamespace>EaCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>
</Project>
